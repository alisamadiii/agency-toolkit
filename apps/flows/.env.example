DATABASE_URL=postgres://postgres:postgres@localhost:5435/flows
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3300
# Encrypts secrets and signing keys. Changing it makes stored secrets unreadable.
MASTER_KEY=change-me
# Path to the deno binary (the Docker image has it on PATH).
DENO_BIN=deno
# all (default) | web | worker
ROLE=all
WORKER_CONCURRENCY=4
RUN_RETENTION_DAYS=30
# Origins allowed to frame /iframe (the client hub). Comma separated.
EMBED_ALLOWED_ORIGINS=https://app.alisamadii.com
# Allowed hosts for workspaces the hub creates on first open ("*" = any public host).
EMBED_DEFAULT_ALLOWED_HOSTS=*
# Client hub API: Google Calendar steps run there, on the Google account the project
# connected in the hub's Calendar app (Flows stores no Google credentials).
# Prod: https://api.alisamadii.com. Local: http://localhost:3000
HUB_API_URL=https://api.alisamadii.com
# Shared secret, 32+ random chars (`openssl rand -hex 32`). Must equal FLOWS_HUB_KEY
# in the hub API's env.
HUB_API_KEY=
