DATABASE_URL=postgres://postgres:postgres@localhost:5435/flows
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3300
# Encrypts secrets and signing keys. Changing it makes stored secrets unreadable.
MASTER_KEY=change-me
# Path to the deno binary (the Docker image has it on PATH).
DENO_BIN=deno
# all (default) | web | worker
ROLE=all
WORKER_CONCURRENCY=4
RUN_RETENTION_DAYS=30
# Base URL used in trigger links (defaults to the request origin).
PUBLIC_URL=
