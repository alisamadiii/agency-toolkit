# Postgres connection string (docker-compose.dev.yml exposes 5434)
DATABASE_URL=postgres://postgres:postgres@localhost:5434/website_tracker

# Random 32+ char secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Public URL the app is served from
BETTER_AUTH_URL=http://localhost:3000

# Secret for manually triggering /api/cron/* jobs
CRON_SECRET=dev-cron-secret

# Where screenshots are stored (defaults to ./data)
# DATA_DIR=./data
